# Dependencies & build artifacts
node_modules/
dist/
coverage/
*.tgz

# Git **does not** support inline comments. Every `#` comment must be on its
# own line (starting with `#`). Anything after a pattern on the same line is
# treated as part of the literal pattern — a silent bug source.
#
# OpenCode dist IS committed (pre-compiled) — the negation below overrides
# the `dist/` pattern above. Keep this line free of trailing comments.
!opencode/dist/

# OS / editor junk
.DS_Store
.idea/
.vscode/

# Project state
.oh-my-sdd/
__pycache__/
*.pyc
.claude/settings.local.json
openspec/
.sisyphus/
.claude/skills/

# superpowers-zh / OpenCode runtime dirs (TOP-LEVEL only — the `/` prefix is
# critical: without it, `.opencode/` would match opencode/.opencode/ too and
# block our authored slash-command definitions under opencode/.opencode/command/).
/.opencode/

# --- opencode/ sub-package: synced mirrors (never commit) ---
# These are generated by `opencode/scripts/copy-resources.mjs` from the parent
# project's skills/, content/, hooks/. Source of truth is the parent directory.
# Postinstall copies them to ~/.config/opencode/ at user install time.
opencode/.opencode/skills/
opencode/.agents/
opencode/skills/
opencode/content/
opencode/hooks/

# Authored opencode/ files that ARE committed:
#   opencode/.opencode/command/*.md   (slash command definitions)
#   opencode/scripts/*.mjs            (build + postinstall helpers)
#   opencode/dist/                    (pre-compiled, see negation above)
#   opencode/src/, opencode/package.json, opencode/tsconfig.json
