{
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run lint:baseline --workspace=@cli-tools/oh-my-sdd && npm run build --workspace=@cli-tools/oh-my-sdd-opencode",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "test:e2e:opencode": "node --test __tests__/integration/opencode/real-cli-e2e.test.js",
    "test:glob": "node --test \"__tests__/**/*.test.js\"",
    "lint:baseline": "npm run lint:baseline --workspace=@cli-tools/oh-my-sdd",
    "sync:opencode": "npm run sync:resources --workspace=@cli-tools/oh-my-sdd-opencode",
    "release:check": "node scripts/release-check.mjs",
    "release:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7"
  }
}
