{
  "name": "@cli-tools/oh-my-sdd",
  "version": "0.1.0",
  "description": "企业级 SDD 工作流 + iam 身份校验 + DOP 埋点（Claude Code 插件）",
  "type": "module",
  "main": "install.js",
  "bin": {
    "oms-install": "./bin/oms-install.js",
    "oms-uninstall": "./bin/oms-uninstall.js",
    "oms-login": "./bin/oms-login.js",
    "oms-wrapper-verify": "./bin/oms-wrapper-verify.js",
    "oms-update": "./bin/oms-update.js",
    "oms-git-hooks": "./bin/oms-git-hooks.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "preuninstall": "node install/uninstall.js",
    "build": "npm run lint:baseline && npm test",
    "build:opencode": "cd opencode && npm install && npx tsc",
    "publish:opencode": "cd opencode && npm publish",
    "prepublishOnly": "npm run build && npm run build:opencode",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "test:glob": "node --test \"__tests__/**/*.test.js\"",
    "lint:baseline": "node scripts/check-baseline-tokens.mjs"
  },
  "files": [
    ".claude-plugin/",
    "install.js",
    "install/",
    "bin/",
    "wrapper/",
    "skills/",
    "content/",
    "hooks/",
    "lib/",
    "README.md",
    "opencode/dist/",
    "opencode/build.js"
  ],
  "publishConfig": {
    "registry": "https://npm.enterprise.com/",
    "access": "restricted"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "sdd",
    "claude-code",
    "plugin",
    "enterprise"
  ],
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enterprise/oh-my-sdd.git"
  },
  "bugs": {
    "url": "https://github.com/enterprise/oh-my-sdd/issues"
  },
  "homepage": "https://github.com/enterprise/oh-my-sdd#readme"
}
